{
    "builds": [
      {
        "src": "public/build/index.html",
        "use": "@vercel/static"
      },
      {
        "src": "package.json",
        "use": "@vercel/node",
        "config": {
          "distDir": "public/build"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/public/build/$1"
      }
    ]
  }
  